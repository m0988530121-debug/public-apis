# Copy this file to .env and fill in your own values.
# NEVER commit the real .env file. It is already covered by .gitignore.

# --- Lark app credentials ---------------------------------------------------
# From the Lark Open Platform: https://open.larksuite.com/  (or
# https://open.feishu.cn/ for Feishu) -> your app -> Credentials & Basic Info.
LARK_APP_ID=cli_xxxxxxxxxxxxxxxx
LARK_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Your open-source AI ("Kun") --------------------------------------------
# Kun talks to any OpenAI-compatible /chat/completions endpoint.
# Examples of KUN_API_BASE:
#   Ollama          http://localhost:11434/v1
#   LM Studio       http://localhost:1234/v1
#   vLLM            http://localhost:8000/v1
#   LocalAI         http://localhost:8080/v1
#   text-gen-webui  http://localhost:5000/v1
KUN_API_BASE=http://localhost:11434/v1

# Model name. LEAVE BLANK to auto-detect whatever model is installed (prefers
# a Qwen / "q"-prefixed one) — then you never have to touch this when the model
# is updated or renamed. Only set it to pin a specific model; if you do, it must
# match an `ollama list` entry EXACTLY including the tag (e.g. qwen2.5:7b).
KUN_MODEL=

# Optional. Many local servers ignore this; cloud/proxied ones may need it.
KUN_API_KEY=

# Optional persona / system instructions.
KUN_SYSTEM_PROMPT=You are Kun, a helpful assistant. Reply concisely.

# Optional tuning.
KUN_TIMEOUT=120
KUN_HISTORY_TURNS=8
